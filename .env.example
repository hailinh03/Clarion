# ─────────────────────────────────────────────────────────────────
# Clarion — .env.example
# Cấu hình: Embedding local, LLM Groq free tier, Qdrant local Docker
# Copy file này thành .env rồi điền các giá trị thực tế.
# ─────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────
APP_ENV=development               # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── LLM Provider ─────────────────────────────────────────────────
# Chọn 1 trong: anthropic | openai | groq | huggingface
LLM_PROVIDER=groq

# Groq (free tier — lấy key tại https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Model cho từng tác vụ (đọc từ MODELS.md)
ANALYZE_LLM_MODEL=openai/gpt-oss-120b   # tác vụ nặng (phân tích ticket)
GENERATION_LLM_MODEL=openai/gpt-oss-120b         # tác vụ nhẹ (gen task/test case)

# Các provider khác — để trống nếu không dùng
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=              # https://huggingface.co/settings/tokens

# ── Embedding ─────────────────────────────────────────────────────
# Chọn: local | openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3       # chạy local, không cần API key
                                  # chiều vector: 1024
                                  # multilingual: Anh + Việt ✓

# ── Qdrant ────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333  # Docker local — không cần API key
QDRANT_API_KEY=                   # để trống khi self-host local

# Tên các collection (phải khớp với code)
QDRANT_COLLECTION_BRD=brd_chunks
QDRANT_COLLECTION_TICKETS=approved_tickets
QDRANT_COLLECTION_TESTCASES=test_cases

# Chiều vector — phải khớp với EMBEDDING_MODEL
# BAAI/bge-m3 → 1024
QDRANT_VECTOR_SIZE=1024

# ── Coverage Check ────────────────────────────────────────────────
COVERAGE_THRESHOLD=0.75           # cosine similarity ngưỡng pass

# ── Celery / Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Jira Integration (future) ─────────────────────────────────────
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_USER_EMAIL=your@email.com
JIRA_API_TOKEN=                   # https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_PROJECT_KEY=PROJ
